+#!/usr/bin/env node
+/** Supprime toute référence à lucie-app-*.base44.app → site GitHub Pages. */
+import fs from 'node:fs';
+import path from 'node:path';
+
+const SITE = 'https://socrate83.github.io/premieres-nations-quebec';
+const OLD = 'https://lucie-app-5fea0268.base44.app';
+
+const pathMap = {
+  Inuit: 'Inuits.html',
+};
+
+function pageUrl(segment) {
+  const s = (segment || '').replace(/^\/+/, '').replace(/\.html$/i, '');
+  if (!s) return `${SITE}/Home.html`;
+  const file = pathMap[s] || `${s}.html`;
+  return `${SITE}/${file}`;
+}
+
+const re = /https:\/\/lucie-app-5fea0268\.base44\.app(\/[^"'\\s&<>]*)?/gi;
+
+const exts = new Set(['.html', '.jsx', '.json', '.js', '.md', '.mdc']);
+const skip = new Set(['.git', 'node_modules', 'scripts']);
+
+function walk(dir, out = []) {
+  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {
+    if (skip.has(e.name)) continue;
+    const full = path.join(dir, e.name);
+    if (e.isDirectory()) walk(full, out);
+    else if (exts.has(path.extname(e.name))) out.push(full);
+  }
+  return out;
+}
+
+let filesChanged = 0;
+let replacements = 0;
+
+for (const file of walk(process.cwd())) {
+  const orig = fs.readFileSync(file, 'utf8');
+  let count = 0;
+  const next = orig.replace(re, (full, pathPart) => {
+    count++;
+    return pageUrl(pathPart || '');
+  });
+  if (next !== orig) {
+    fs.writeFileSync(file, next, 'utf8');
+    filesChanged++;
+    replacements += count;
+  }
+}
+
+console.log(`Liens ${OLD} → ${SITE} : ${replacements} remplacement(s) dans ${filesChanged} fichier(s).`);
